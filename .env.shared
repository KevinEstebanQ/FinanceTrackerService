HOST=127.0.0.1
DEVELOPMENT=True

# SQLite (default local/dev)
DATABASE_URL=sqlite:///./finance.db

# Postgres (Docker Compose — matches POSTGRES_* vars below)
# DATABASE_URL=postgresql+psycopg_async://finance_user:finance_pass@db:5432/finance_tracker

AUTH_SERVICE_URL=https://graceful-caring-production-296f.up.railway.app
AUTH_TOKEN_URL=https://graceful-caring-production-296f.up.railway.app/auth/login

SECRET_KEY=CHANGE-ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Postgres container (Docker Compose only — Railway uses DATABASE_URL directly)
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=finance_pass
POSTGRES_DB=finance_tracker
POSTGRES_CONTAINER_NAME=db
POSTGRES_PORT=5432

# Redis (Phase 4 — not yet active)
REDIS_URL=redis://redis:6379/0

# Uvicorn workers (set to number of CPU cores; default 1 for dev)
UVICORN_WORKERS=4

# Grafana (observability — Phase 7)
GRAFANA_CONTAINER_NAME=grafana
GRAFANA_PORT=3000
